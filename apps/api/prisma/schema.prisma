// Fundação do Santos Sistema Administrativo Financeiro.
// `url` é usado pelo client em runtime (papel app_user, restrito por RLS).
// `directUrl` é usado só por `prisma migrate` (papel app_migrator, dono das tabelas).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("MIGRATE_DATABASE_URL")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum LineDirection {
  DEBIT
  CREDIT
}

enum CounterpartyType {
  SUPPLIER
  CUSTOMER
  BOTH
}

enum BankAccountKind {
  BANK
  CASH
}

enum TitleStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  CANCELED
}

enum FixedAssetStatus {
  ACTIVE
  FULLY_DEPRECIATED
  DISPOSED
}

enum BudgetStatus {
  DRAFT
  APPROVED
  CLOSED
}

enum StockMovementType {
  INBOUND
  OUTBOUND
}

enum BankReconciliationStatus {
  OPEN
  CLOSED
}

enum BankStatementLineStatus {
  PENDING
  MATCHED
  ADJUSTED
  IGNORED
}

enum EmployeeStatus {
  ACTIVE
  TERMINATED
}

enum TaxBracketType {
  INSS
  IRRF
}

// Status compartilhado por todo evento de folha (folha mensal, férias, 13º,
// rescisão): DRAFT (dados carregados, nada calculado) -> CALCULATED (valores
// computados, ainda sem lançamento contábil) -> POSTED (lançamento gerado,
// imutável a partir daqui — mesmo raciocínio de BudgetPlan/BankReconciliation).
enum PayrollEventStatus {
  DRAFT
  CALCULATED
  POSTED
}

enum ThirteenthSalaryInstallment {
  FIRST
  SECOND
  SINGLE
}

enum TerminationType {
  WITHOUT_CAUSE
  RESIGNATION
  WITH_CAUSE
  MUTUAL_AGREEMENT
}

enum RegimeTributario {
  SIMPLES_NACIONAL
  LUCRO_PRESUMIDO
  LUCRO_REAL
}

enum AnexoSimplesNacional {
  I
  II
  III
  IV
  V
}

enum PisCofinsRegime {
  CUMULATIVO
  NAO_CUMULATIVO
}

model Organization {
  id        String   @id @default(uuid())
  // Identificador público usado para resolver o tenant no login, antes de
  // haver qualquer sessão autenticada — evita expor a tabela `users` sem
  // contexto de organização já definido (ver módulo auth).
  slug      String   @unique
  name      String
  taxId     String?  @unique @map("tax_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users                         User[]
  roles                         Role[]
  costCenters                   CostCenter[]
  accounts                      Account[]
  journalEntries                JournalEntry[]
  counterparties                Counterparty[]
  bankAccounts                  BankAccount[]
  accountsPayable               AccountsPayable[]
  accountsPayablePayments       AccountsPayablePayment[]
  accountsReceivable            AccountsReceivable[]
  accountsReceivableReceipts    AccountsReceivableReceipt[]
  fixedAssets                   FixedAsset[]
  fixedAssetDepreciationEntries FixedAssetDepreciationEntry[]
  budgetPlans                   BudgetPlan[]
  budgetLines                   BudgetLine[]
  warehouses                    Warehouse[]
  inventoryItems                InventoryItem[]
  warehouseStocks               WarehouseStock[]
  stockMovements                StockMovement[]
  stockTransfers                StockTransfer[]
  bankReconciliations           BankReconciliation[]
  bankStatementLines            BankStatementLine[]
  employees                     Employee[]
  payrollSettings               PayrollSettings?
  payrollTaxBrackets            PayrollTaxBracket[]
  payrollRuns                   PayrollRun[]
  payrollRunLines               PayrollRunLine[]
  vacations                     Vacation[]
  thirteenthSalaryRuns          ThirteenthSalaryRun[]
  thirteenthSalaryRunLines      ThirteenthSalaryRunLine[]
  terminations                  Termination[]
  fiscalTaxSettings             FiscalTaxSettings?
  simplesNacionalBrackets       SimplesNacionalBracket[]
  icmsUfRates                   IcmsUfRate[]
  fiscalDocumentosEmitidos      FiscalDocumentoEmitido[]

  @@map("organizations")
}

model User {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  email          String
  passwordHash   String   @map("password_hash")
  fullName       String   @map("full_name")
  isActive       Boolean  @default(true) @map("is_active")
  // Incrementado sempre que papéis/permissões do usuário mudam; comparado
  // contra o claim do JWT para permitir revogação quase-imediata sem sessão
  // stateful por requisição.
  securityStamp  Int      @default(0) @map("security_stamp")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userRoles     UserRole[]
  refreshTokens RefreshToken[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
}

// Catálogo global de permissões (module:action). Não é dado de tenant — sem organization_id, sem RLS.
model Permission {
  id     String @id @default(uuid())
  module String
  action String
  key    String @unique

  rolePermissions RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model Role {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at")

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("roles")
}

model RolePermission {
  organizationId String @map("organization_id")
  roleId         String @map("role_id")
  permissionId   String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([organizationId])
  @@map("role_permissions")
}

model UserRole {
  organizationId String @map("organization_id")
  userId         String @map("user_id")
  roleId         String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([organizationId])
  @@map("user_roles")
}

model RefreshToken {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  userId         String    @map("user_id")
  tokenHash      String    @map("token_hash")
  familyId       String    @map("family_id")
  replacedById   String?   @map("replaced_by_id")
  expiresAt      DateTime  @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model CostCenter {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  code           String
  name           String
  parentId       String?  @map("parent_id")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parent             CostCenter?          @relation("CostCenterHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children           CostCenter[]         @relation("CostCenterHierarchy")
  accounts           Account[]
  journalEntryLines  JournalEntryLine[]
  accountsPayable    AccountsPayable[]
  accountsReceivable AccountsReceivable[]
  fixedAssets        FixedAsset[]
  budgetLines        BudgetLine[]
  employees          Employee[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, parentId])
  @@map("cost_centers")
}

model Account {
  id             String      @id @default(uuid())
  organizationId String      @map("organization_id")
  code           String
  name           String
  type           AccountType
  parentId       String?     @map("parent_id")
  // Mantido por trigger no banco (AFTER INSERT/UPDATE/DELETE em accounts) —
  // nunca definido diretamente pela aplicação. Só contas analíticas (sem filhos) recebem lançamento.
  isAnalytic     Boolean     @default(true) @map("is_analytic")
  isActive       Boolean     @default(true) @map("is_active")
  costCenterId   String?     @map("cost_center_id")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  organization                          Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parent                                Account?             @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children                              Account[]            @relation("AccountHierarchy")
  costCenter                            CostCenter?          @relation(fields: [costCenterId], references: [id], onDelete: Restrict)
  journalEntryLines                     JournalEntryLine[]
  bankAccounts                          BankAccount[]
  apExpenseEntries                      AccountsPayable[]    @relation("APExpenseAccount")
  apLiabilityEntries                    AccountsPayable[]    @relation("APLiabilityAccount")
  arAssetEntries                        AccountsReceivable[] @relation("ARAssetAccount")
  arRevenueEntries                      AccountsReceivable[] @relation("ARRevenueAccount")
  fixedAssetsAsAsset                    FixedAsset[]         @relation("FixedAssetAssetAccount")
  fixedAssetsAsAccumDepr                FixedAsset[]         @relation("FixedAssetAccumDeprAccount")
  fixedAssetsAsDeprExpense              FixedAsset[]         @relation("FixedAssetDeprExpenseAccount")
  fixedAssetsAsLossOnDisposal           FixedAsset[]         @relation("FixedAssetLossOnDisposalAccount")
  budgetLines                           BudgetLine[]
  inventoryItems                        InventoryItem[]      @relation("InventoryItemAccount")
  stockMovementsAsCounter               StockMovement[]      @relation("StockMovementCounterAccount")
  payrollSalaryExpenseSettings          PayrollSettings[]    @relation("PayrollSalaryExpenseAccount")
  payrollSalaryPayableSettings          PayrollSettings[]    @relation("PayrollSalaryPayableAccount")
  payrollInssPayableSettings            PayrollSettings[]    @relation("PayrollInssPayableAccount")
  payrollIrrfPayableSettings            PayrollSettings[]    @relation("PayrollIrrfPayableAccount")
  payrollEmployerChargesExpenseSettings PayrollSettings[]    @relation("PayrollEmployerChargesExpenseAccount")
  payrollFgtsPayableSettings            PayrollSettings[]    @relation("PayrollFgtsPayableAccount")
  payrollEmployerInssPayableSettings    PayrollSettings[]    @relation("PayrollEmployerInssPayableAccount")
  payrollBenefitsExpenseSettings        PayrollSettings[]    @relation("PayrollBenefitsExpenseAccount")
  payrollBenefitsPayableSettings        PayrollSettings[]    @relation("PayrollBenefitsPayableAccount")
  payrollFgtsFineExpenseSettings        PayrollSettings[]    @relation("PayrollFgtsFineExpenseAccount")
  payrollFgtsFinePayableSettings        PayrollSettings[]    @relation("PayrollFgtsFinePayableAccount")
  fiscalReceitaVendasSettings           FiscalTaxSettings[]  @relation("FiscalReceitaVendasAccount")
  fiscalReceitaServicosSettings         FiscalTaxSettings[]  @relation("FiscalReceitaServicosAccount")
  fiscalDeducoesVendasSettings          FiscalTaxSettings[]  @relation("FiscalDeducoesVendasAccount")
  fiscalDeducoesServicosSettings        FiscalTaxSettings[]  @relation("FiscalDeducoesServicosAccount")
  fiscalClientesReceberSettings         FiscalTaxSettings[]  @relation("FiscalClientesReceberAccount")
  fiscalIcmsPayableSettings             FiscalTaxSettings[]  @relation("FiscalIcmsPayableAccount")
  fiscalPisPayableSettings              FiscalTaxSettings[]  @relation("FiscalPisPayableAccount")
  fiscalCofinsPayableSettings           FiscalTaxSettings[]  @relation("FiscalCofinsPayableAccount")
  fiscalIssPayableSettings              FiscalTaxSettings[]  @relation("FiscalIssPayableAccount")
  fiscalSimplesPayableSettings          FiscalTaxSettings[]  @relation("FiscalSimplesPayableAccount")

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, parentId])
  @@map("accounts")
}

// Contador atômico por organização, usado para numerar lançamentos sem
// buracos sob concorrência (ver migração de RLS/triggers para o padrão de incremento).
model SequenceCounter {
  organizationId String @map("organization_id")
  counterKey     String @map("counter_key")
  currentValue   BigInt @default(0) @map("current_value")

  @@id([organizationId, counterKey])
  @@map("sequence_counters")
}

model JournalEntry {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  entryNumber     BigInt   @map("entry_number")
  entryDate       DateTime @map("entry_date") @db.Date
  competenceDate  DateTime @map("competence_date") @db.Date
  description     String
  // Módulo de origem do lançamento (ex.: MANUAL, BANK, CASH, AP, AR, FIXED_ASSET, FISCAL).
  // String livre (não enum) para que novos módulos não exijam migração de schema.
  referenceModule String   @default("MANUAL") @map("reference_module")
  referenceId     String?  @map("reference_id")
  reversalOfId    String?  @map("reversal_of_id")
  createdBy       String   @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")

  organization                  Organization                  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  lines                         JournalEntryLine[]
  accountsPayableAccruals       AccountsPayable[]
  accountsReceivableAccruals    AccountsReceivable[]
  accountsPayablePayments       AccountsPayablePayment[]
  accountsReceivableReceipts    AccountsReceivableReceipt[]
  fixedAssetDisposals           FixedAsset[]                  @relation("FixedAssetDisposal")
  fixedAssetDepreciationEntries FixedAssetDepreciationEntry[] @relation("FixedAssetDepreciationPosting")
  stockMovements                StockMovement[]
  payrollRuns                   PayrollRun[]
  vacations                     Vacation[]
  thirteenthSalaryRuns          ThirteenthSalaryRun[]
  terminations                  Termination[]
  fiscalDocumentosEmitidos      FiscalDocumentoEmitido[]

  @@unique([organizationId, entryNumber])
  @@index([organizationId, entryDate])
  @@index([organizationId, competenceDate])
  @@map("journal_entries")
}

model JournalEntryLine {
  id             String        @id @default(uuid())
  // Denormalizado do header para que a policy de RLS seja uma comparação direta, sem join.
  organizationId String        @map("organization_id")
  journalEntryId String        @map("journal_entry_id")
  accountId      String        @map("account_id")
  costCenterId   String?       @map("cost_center_id")
  direction      LineDirection
  amount         Decimal       @db.Decimal(18, 2)
  lineNumber     Int           @map("line_number")

  journalEntry        JournalEntry       @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account             Account            @relation(fields: [accountId], references: [id], onDelete: Restrict)
  costCenter          CostCenter?        @relation(fields: [costCenterId], references: [id], onDelete: Restrict)
  reconciliationMatch BankStatementLine?

  @@index([organizationId])
  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_entry_lines")
}

model Counterparty {
  id             String           @id @default(uuid())
  organizationId String           @map("organization_id")
  type           CounterpartyType
  taxId          String?          @map("tax_id")
  name           String
  email          String?
  phone          String?
  isActive       Boolean          @default(true) @map("is_active")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  accountsPayable    AccountsPayable[]
  accountsReceivable AccountsReceivable[]

  @@unique([organizationId, taxId])
  @@index([organizationId])
  @@map("counterparties")
}

model BankAccount {
  id             String          @id @default(uuid())
  organizationId String          @map("organization_id")
  kind           BankAccountKind
  name           String
  bankCode       String?         @map("bank_code")
  agency         String?
  accountNumber  String?         @map("account_number")
  glAccountId    String          @map("gl_account_id")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  organization    Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  glAccount       Account                     @relation(fields: [glAccountId], references: [id], onDelete: Restrict)
  payments        AccountsPayablePayment[]
  receipts        AccountsReceivableReceipt[]
  reconciliations BankReconciliation[]
  statementLines  BankStatementLine[]

  @@index([organizationId])
  @@map("bank_accounts")
}

model AccountsPayable {
  id                    String      @id @default(uuid())
  organizationId        String      @map("organization_id")
  documentNumber        BigInt      @map("document_number")
  counterpartyId        String      @map("counterparty_id")
  description           String
  issueDate             DateTime    @map("issue_date") @db.Date
  dueDate               DateTime    @map("due_date") @db.Date
  competenceDate        DateTime    @map("competence_date") @db.Date
  originalAmount        Decimal     @map("original_amount") @db.Decimal(18, 2)
  paidAmount            Decimal     @default(0) @map("paid_amount") @db.Decimal(18, 2)
  expenseAccountId      String      @map("expense_account_id")
  liabilityAccountId    String      @map("liability_account_id")
  costCenterId          String?     @map("cost_center_id")
  status                TitleStatus @default(OPEN)
  accrualJournalEntryId String      @map("accrual_journal_entry_id")
  createdBy             String      @map("created_by")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")

  organization        Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  counterparty        Counterparty             @relation(fields: [counterpartyId], references: [id], onDelete: Restrict)
  expenseAccount      Account                  @relation("APExpenseAccount", fields: [expenseAccountId], references: [id], onDelete: Restrict)
  liabilityAccount    Account                  @relation("APLiabilityAccount", fields: [liabilityAccountId], references: [id], onDelete: Restrict)
  costCenter          CostCenter?              @relation(fields: [costCenterId], references: [id], onDelete: Restrict)
  accrualJournalEntry JournalEntry             @relation(fields: [accrualJournalEntryId], references: [id], onDelete: Restrict)
  payments            AccountsPayablePayment[]

  @@unique([organizationId, documentNumber])
  @@index([organizationId, status, dueDate])
  @@index([organizationId, counterpartyId])
  @@map("accounts_payable")
}

model AccountsPayablePayment {
  id                String   @id @default(uuid())
  organizationId    String   @map("organization_id")
  accountsPayableId String   @map("accounts_payable_id")
  paymentDate       DateTime @map("payment_date") @db.Date
  amount            Decimal  @db.Decimal(18, 2)
  bankAccountId     String   @map("bank_account_id")
  journalEntryId    String   @map("journal_entry_id")
  createdBy         String   @map("created_by")
  createdAt         DateTime @default(now()) @map("created_at")

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  accountsPayable AccountsPayable @relation(fields: [accountsPayableId], references: [id], onDelete: Restrict)
  bankAccount     BankAccount     @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  journalEntry    JournalEntry    @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([accountsPayableId])
  @@map("accounts_payable_payments")
}

model AccountsReceivable {
  id                    String      @id @default(uuid())
  organizationId        String      @map("organization_id")
  documentNumber        BigInt      @map("document_number")
  counterpartyId        String      @map("counterparty_id")
  description           String
  issueDate             DateTime    @map("issue_date") @db.Date
  dueDate               DateTime    @map("due_date") @db.Date
  competenceDate        DateTime    @map("competence_date") @db.Date
  originalAmount        Decimal     @map("original_amount") @db.Decimal(18, 2)
  receivedAmount        Decimal     @default(0) @map("received_amount") @db.Decimal(18, 2)
  assetAccountId        String      @map("asset_account_id")
  revenueAccountId      String      @map("revenue_account_id")
  costCenterId          String?     @map("cost_center_id")
  status                TitleStatus @default(OPEN)
  accrualJournalEntryId String      @map("accrual_journal_entry_id")
  createdBy             String      @map("created_by")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")

  organization        Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  counterparty        Counterparty                @relation(fields: [counterpartyId], references: [id], onDelete: Restrict)
  assetAccount        Account                     @relation("ARAssetAccount", fields: [assetAccountId], references: [id], onDelete: Restrict)
  revenueAccount      Account                     @relation("ARRevenueAccount", fields: [revenueAccountId], references: [id], onDelete: Restrict)
  costCenter          CostCenter?                 @relation(fields: [costCenterId], references: [id], onDelete: Restrict)
  accrualJournalEntry JournalEntry                @relation(fields: [accrualJournalEntryId], references: [id], onDelete: Restrict)
  receipts            AccountsReceivableReceipt[]

  @@unique([organizationId, documentNumber])
  @@index([organizationId, status, dueDate])
  @@index([organizationId, counterpartyId])
  @@map("accounts_receivable")
}

model AccountsReceivableReceipt {
  id                   String   @id @default(uuid())
  organizationId       String   @map("organization_id")
  accountsReceivableId String   @map("accounts_receivable_id")
  receiptDate          DateTime @map("receipt_date") @db.Date
  amount               Decimal  @db.Decimal(18, 2)
  bankAccountId        String   @map("bank_account_id")
  journalEntryId       String   @map("journal_entry_id")
  createdBy            String   @map("created_by")
  createdAt            DateTime @default(now()) @map("created_at")

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  accountsReceivable AccountsReceivable @relation(fields: [accountsReceivableId], references: [id], onDelete: Restrict)
  bankAccount        BankAccount        @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  journalEntry       JournalEntry       @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([accountsReceivableId])
  @@map("accounts_receivable_receipts")
}

model FixedAsset {
  id                               String           @id @default(uuid())
  organizationId                   String           @map("organization_id")
  assetNumber                      BigInt           @map("asset_number")
  description                      String
  acquisitionDate                  DateTime         @map("acquisition_date") @db.Date
  acquisitionCost                  Decimal          @map("acquisition_cost") @db.Decimal(18, 2)
  residualValue                    Decimal          @default(0) @map("residual_value") @db.Decimal(18, 2)
  usefulLifeMonths                 Int              @map("useful_life_months")
  accumulatedDepreciation          Decimal          @default(0) @map("accumulated_depreciation") @db.Decimal(18, 2)
  assetAccountId                   String           @map("asset_account_id")
  accumulatedDepreciationAccountId String           @map("accumulated_depreciation_account_id")
  depreciationExpenseAccountId     String           @map("depreciation_expense_account_id")
  costCenterId                     String?          @map("cost_center_id")
  status                           FixedAssetStatus @default(ACTIVE)
  disposalDate                     DateTime?        @map("disposal_date") @db.Date
  disposalJournalEntryId           String?          @map("disposal_journal_entry_id")
  lossOnDisposalAccountId          String?          @map("loss_on_disposal_account_id")
  createdBy                        String           @map("created_by")
  createdAt                        DateTime         @default(now()) @map("created_at")
  updatedAt                        DateTime         @updatedAt @map("updated_at")

  organization                   Organization                  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assetAccount                   Account                       @relation("FixedAssetAssetAccount", fields: [assetAccountId], references: [id], onDelete: Restrict)
  accumulatedDepreciationAccount Account                       @relation("FixedAssetAccumDeprAccount", fields: [accumulatedDepreciationAccountId], references: [id], onDelete: Restrict)
  depreciationExpenseAccount     Account                       @relation("FixedAssetDeprExpenseAccount", fields: [depreciationExpenseAccountId], references: [id], onDelete: Restrict)
  lossOnDisposalAccount          Account?                      @relation("FixedAssetLossOnDisposalAccount", fields: [lossOnDisposalAccountId], references: [id], onDelete: Restrict)
  costCenter                     CostCenter?                   @relation(fields: [costCenterId], references: [id], onDelete: Restrict)
  disposalJournalEntry           JournalEntry?                 @relation("FixedAssetDisposal", fields: [disposalJournalEntryId], references: [id], onDelete: Restrict)
  depreciationEntries            FixedAssetDepreciationEntry[]

  @@unique([organizationId, assetNumber])
  @@index([organizationId, status])
  @@map("fixed_assets")
}

model FixedAssetDepreciationEntry {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  fixedAssetId    String   @map("fixed_asset_id")
  competenceMonth DateTime @map("competence_month") @db.Date
  amount          Decimal  @db.Decimal(18, 2)
  journalEntryId  String   @map("journal_entry_id")
  createdBy       String   @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  fixedAsset   FixedAsset   @relation(fields: [fixedAssetId], references: [id], onDelete: Restrict)
  journalEntry JournalEntry @relation("FixedAssetDepreciationPosting", fields: [journalEntryId], references: [id], onDelete: Restrict)

  @@unique([organizationId, fixedAssetId, competenceMonth])
  @@map("fixed_asset_depreciation_entries")
}

// Orçamento é razão auxiliar de planejamento — não posta lançamento algum
// (mesma lógica de FixedAsset: comparação, não geração de partidas). Um
// BudgetPlan é imutável quanto a nome/ano fora do estado DRAFT; suas linhas
// só podem ser criadas/editadas/removidas enquanto o plano está em DRAFT
// (garantido na camada de aplicação, ver BudgetService — não há REVOKE de
// UPDATE/DELETE no banco porque, ao contrário de lançamentos e pagamentos,
// a edição é legítima durante o rascunho).
model BudgetPlan {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  fiscalYear     Int          @map("fiscal_year")
  name           String
  status         BudgetStatus @default(DRAFT)
  approvedBy     String?      @map("approved_by")
  approvedAt     DateTime?    @map("approved_at")
  closedAt       DateTime?    @map("closed_at")
  createdBy      String       @map("created_by")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  lines        BudgetLine[]

  @@index([organizationId, fiscalYear])
  @@map("budget_plans")
}

model BudgetLine {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  budgetPlanId   String   @map("budget_plan_id")
  accountId      String   @map("account_id")
  costCenterId   String   @map("cost_center_id")
  // 1 a 12 — validado no DTO e reforçado por CHECK constraint na migração de RLS.
  month          Int
  amount         Decimal  @db.Decimal(18, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  budgetPlan   BudgetPlan   @relation(fields: [budgetPlanId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  costCenter   CostCenter   @relation(fields: [costCenterId], references: [id], onDelete: Restrict)

  @@unique([organizationId, budgetPlanId, accountId, costCenterId, month])
  @@index([organizationId, budgetPlanId])
  @@map("budget_lines")
}

model Warehouse {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  code           String
  name           String
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  stocks        WarehouseStock[]
  movements     StockMovement[]
  transfersFrom StockTransfer[]  @relation("TransferFromWarehouse")
  transfersTo   StockTransfer[]  @relation("TransferToWarehouse")

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("warehouses")
}

// Custeio por média ponderada móvel, global por item (não por depósito) —
// custo médio é um único número recalculado a cada entrada; depósitos só
// segmentam ONDE fisicamente o item está (WarehouseStock), não a que custo.
// Transferência entre depósitos, portanto, nunca muda average_cost/
// total_quantity nem posta lançamento (mesma conta contábil de estoque nos
// dois lados) — só redistribui quantidade entre WarehouseStock.
model InventoryItem {
  id                 String   @id @default(uuid())
  organizationId     String   @map("organization_id")
  code               String
  name               String
  unit               String
  inventoryAccountId String   @map("inventory_account_id")
  averageCost        Decimal  @default(0) @map("average_cost") @db.Decimal(18, 4)
  totalQuantity      Decimal  @default(0) @map("total_quantity") @db.Decimal(18, 3)
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  inventoryAccount Account          @relation("InventoryItemAccount", fields: [inventoryAccountId], references: [id], onDelete: Restrict)
  stocks           WarehouseStock[]
  movements        StockMovement[]
  transfers        StockTransfer[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("inventory_items")
}

model WarehouseStock {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  itemId         String  @map("item_id")
  warehouseId    String  @map("warehouse_id")
  quantity       Decimal @default(0) @db.Decimal(18, 3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  item         InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  warehouse    Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([organizationId, itemId, warehouseId])
  @@index([organizationId, warehouseId])
  @@map("warehouse_stock")
}

// Apêndice imutável do item, mesmo padrão de accounts_payable_payments/
// fixed_asset_depreciation_entries (ver migração de RLS): entrada/saída
// sempre posta lançamento (débito/crédito na conta de estoque do item) e
// nunca é editada/removida depois — correção é sempre por um novo movimento
// em sentido contrário, nunca edição do histórico.
model StockMovement {
  id               String            @id @default(uuid())
  organizationId   String            @map("organization_id")
  itemId           String            @map("item_id")
  warehouseId      String            @map("warehouse_id")
  type             StockMovementType
  quantity         Decimal           @db.Decimal(18, 3)
  // Para INBOUND, o custo informado no lançamento; para OUTBOUND, uma cópia
  // do average_cost do item NO MOMENTO do movimento (auditoria — o item
  // pode ter um average_cost diferente depois de entradas futuras).
  unitCost         Decimal           @map("unit_cost") @db.Decimal(18, 4)
  totalCost        Decimal           @map("total_cost") @db.Decimal(18, 2)
  counterAccountId String            @map("counter_account_id")
  movementDate     DateTime          @map("movement_date") @db.Date
  journalEntryId   String            @map("journal_entry_id")
  createdBy        String            @map("created_by")
  createdAt        DateTime          @default(now()) @map("created_at")

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  item           InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  warehouse      Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  counterAccount Account       @relation("StockMovementCounterAccount", fields: [counterAccountId], references: [id], onDelete: Restrict)
  journalEntry   JournalEntry  @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)

  @@index([organizationId, itemId])
  @@index([organizationId, warehouseId])
  @@map("stock_movements")
}

// Também imutável (mesmo padrão de StockMovement) — não posta lançamento
// (ver comentário em InventoryItem) nem muda custo/quantidade total do item.
model StockTransfer {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  itemId          String   @map("item_id")
  fromWarehouseId String   @map("from_warehouse_id")
  toWarehouseId   String   @map("to_warehouse_id")
  quantity        Decimal  @db.Decimal(18, 3)
  transferDate    DateTime @map("transfer_date") @db.Date
  createdBy       String   @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  item          InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  fromWarehouse Warehouse     @relation("TransferFromWarehouse", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouse   Warehouse     @relation("TransferToWarehouse", fields: [toWarehouseId], references: [id], onDelete: Restrict)

  @@index([organizationId, itemId])
  @@map("stock_transfers")
}

// Uma "sessão" de conciliação = um extrato (OFX) importado para uma conta
// bancária num período. Diferente de JournalEntry/StockMovement, NÃO é
// imutável: linhas mudam de status (PENDING -> MATCHED/ADJUSTED/IGNORED) e a
// sessão mesma vai de OPEN -> CLOSED — mesmo raciocínio de BudgetPlan (regra
// de transição de estado é responsabilidade do serviço, não de REVOKE no
// banco). Fechar exige diferença zero entre statement_closing_balance e o
// saldo do razão na glAccount do BankAccount na data de periodEnd (ver
// BankReconciliationService.close).
model BankReconciliation {
  id                      String                   @id @default(uuid())
  organizationId          String                   @map("organization_id")
  bankAccountId           String                   @map("bank_account_id")
  periodStart             DateTime                 @map("period_start") @db.Date
  periodEnd               DateTime                 @map("period_end") @db.Date
  statementClosingBalance Decimal                  @map("statement_closing_balance") @db.Decimal(18, 2)
  status                  BankReconciliationStatus @default(OPEN)
  createdBy               String                   @map("created_by")
  createdAt               DateTime                 @default(now()) @map("created_at")
  closedAt                DateTime?                @map("closed_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  bankAccount  BankAccount         @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  lines        BankStatementLine[]

  @@index([organizationId, bankAccountId])
  @@map("bank_reconciliations")
}

// amount é assinado: positivo = crédito no extrato (dinheiro entrando, casa
// com DEBIT na glAccount do banco, que é conta de ativo), negativo = débito
// no extrato (casa com CREDIT). fitId é o identificador único do banco no
// OFX — usado para não reimportar a mesma transação duas vezes.
model BankStatementLine {
  id                        String                  @id @default(uuid())
  organizationId            String                  @map("organization_id")
  bankReconciliationId      String                  @map("bank_reconciliation_id")
  bankAccountId             String                  @map("bank_account_id")
  transactionDate           DateTime                @map("transaction_date") @db.Date
  amount                    Decimal                 @db.Decimal(18, 2)
  description               String
  fitId                     String?                 @map("fit_id")
  status                    BankStatementLineStatus @default(PENDING)
  matchedJournalEntryLineId String?                 @unique @map("matched_journal_entry_line_id")
  createdAt                 DateTime                @default(now()) @map("created_at")

  organization            Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  bankReconciliation      BankReconciliation @relation(fields: [bankReconciliationId], references: [id], onDelete: Cascade)
  bankAccount             BankAccount        @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  matchedJournalEntryLine JournalEntryLine?  @relation(fields: [matchedJournalEntryLineId], references: [id], onDelete: Restrict)

  @@index([organizationId, bankReconciliationId])
  @@index([organizationId, bankAccountId, fitId])
  @@map("bank_statement_lines")
}

// ============================================================================
// Departamento Pessoal
// ============================================================================
// Simplificações assumidas (ver PayrollCalculationService para o detalhe):
// aviso prévio sempre indenizado (nunca trabalhado); sem salário-família,
// adicionais de insalubridade/periculosidade, horas extras ou afastamentos;
// regime de caixa (férias/13º contabilizados quando pagos, sem provisão
// mensal ao longo do ano); encargos patronais como alíquota agregada
// configurável (sem quebra INSS patronal/RAT/terceiros); cargo é texto livre
// no cadastro do funcionário, sem uma entidade própria de cargos/carreira.

model Employee {
  id                           String         @id @default(uuid())
  organizationId               String         @map("organization_id")
  registrationNumber           BigInt         @map("registration_number")
  fullName                     String         @map("full_name")
  cpf                          String
  admissionDate                DateTime       @map("admission_date") @db.Date
  terminationDate              DateTime?      @map("termination_date") @db.Date
  position                     String
  costCenterId                 String?        @map("cost_center_id")
  baseSalary                   Decimal        @map("base_salary") @db.Decimal(18, 2)
  dependentsCount              Int            @default(0) @map("dependents_count")
  transportVoucherMonthlyValue Decimal?       @map("transport_voucher_monthly_value") @db.Decimal(18, 2)
  mealVoucherMonthlyValue      Decimal?       @map("meal_voucher_monthly_value") @db.Decimal(18, 2)
  // Percentual (0 a 1) descontado do empregado sobre o valor do vale-refeição/
  // alimentação — o restante é custo da empresa. Muitas empresas não
  // descontam nada do empregado (fica null/0).
  mealVoucherDiscountRate      Decimal?       @map("meal_voucher_discount_rate") @db.Decimal(5, 4)
  status                       EmployeeStatus @default(ACTIVE)
  createdBy                    String         @map("created_by")
  createdAt                    DateTime       @default(now()) @map("created_at")
  updatedAt                    DateTime       @updatedAt @map("updated_at")

  organization          Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  costCenter            CostCenter?               @relation(fields: [costCenterId], references: [id], onDelete: Restrict)
  payrollRunLines       PayrollRunLine[]
  vacations             Vacation[]
  thirteenthSalaryLines ThirteenthSalaryRunLine[]
  terminations          Termination[]

  @@unique([organizationId, registrationNumber])
  @@unique([organizationId, cpf])
  @@index([organizationId, status])
  @@map("employees")
}

// Singleton por organização — criado sob demanda (get-or-create) com
// alíquotas/tabelas de referência e nenhuma conta contábil mapeada; o
// serviço de folha/férias/13º/rescisão recusa calcular enquanto as contas
// não forem configuradas (mesmo raciocínio de "erro amigável antes do
// round-trip" usado em BankAccountsService).
model PayrollSettings {
  id                              String  @id @default(uuid())
  organizationId                  String  @unique @map("organization_id")
  irrfDependentDeduction          Decimal @map("irrf_dependent_deduction") @db.Decimal(18, 2)
  inssCeiling                     Decimal @map("inss_ceiling") @db.Decimal(18, 2)
  fgtsRate                        Decimal @map("fgts_rate") @db.Decimal(5, 4)
  employerInssRate                Decimal @map("employer_inss_rate") @db.Decimal(5, 4)
  fgtsFineRateWithoutCause        Decimal @map("fgts_fine_rate_without_cause") @db.Decimal(5, 4)
  fgtsFineRateMutualAgreement     Decimal @map("fgts_fine_rate_mutual_agreement") @db.Decimal(5, 4)
  transportVoucherMaxDiscountRate Decimal @map("transport_voucher_max_discount_rate") @db.Decimal(5, 4)

  salaryExpenseAccountId          String? @map("salary_expense_account_id")
  salaryPayableAccountId          String? @map("salary_payable_account_id")
  inssPayableAccountId            String? @map("inss_payable_account_id")
  irrfPayableAccountId            String? @map("irrf_payable_account_id")
  employerChargesExpenseAccountId String? @map("employer_charges_expense_account_id")
  fgtsPayableAccountId            String? @map("fgts_payable_account_id")
  employerInssPayableAccountId    String? @map("employer_inss_payable_account_id")
  benefitsExpenseAccountId        String? @map("benefits_expense_account_id")
  benefitsPayableAccountId        String? @map("benefits_payable_account_id")
  fgtsFineExpenseAccountId        String? @map("fgts_fine_expense_account_id")
  fgtsFinePayableAccountId        String? @map("fgts_fine_payable_account_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization                  Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  salaryExpenseAccount          Account?            @relation("PayrollSalaryExpenseAccount", fields: [salaryExpenseAccountId], references: [id], onDelete: Restrict)
  salaryPayableAccount          Account?            @relation("PayrollSalaryPayableAccount", fields: [salaryPayableAccountId], references: [id], onDelete: Restrict)
  inssPayableAccount            Account?            @relation("PayrollInssPayableAccount", fields: [inssPayableAccountId], references: [id], onDelete: Restrict)
  irrfPayableAccount            Account?            @relation("PayrollIrrfPayableAccount", fields: [irrfPayableAccountId], references: [id], onDelete: Restrict)
  employerChargesExpenseAccount Account?            @relation("PayrollEmployerChargesExpenseAccount", fields: [employerChargesExpenseAccountId], references: [id], onDelete: Restrict)
  fgtsPayableAccount            Account?            @relation("PayrollFgtsPayableAccount", fields: [fgtsPayableAccountId], references: [id], onDelete: Restrict)
  employerInssPayableAccount    Account?            @relation("PayrollEmployerInssPayableAccount", fields: [employerInssPayableAccountId], references: [id], onDelete: Restrict)
  benefitsExpenseAccount        Account?            @relation("PayrollBenefitsExpenseAccount", fields: [benefitsExpenseAccountId], references: [id], onDelete: Restrict)
  benefitsPayableAccount        Account?            @relation("PayrollBenefitsPayableAccount", fields: [benefitsPayableAccountId], references: [id], onDelete: Restrict)
  fgtsFineExpenseAccount        Account?            @relation("PayrollFgtsFineExpenseAccount", fields: [fgtsFineExpenseAccountId], references: [id], onDelete: Restrict)
  fgtsFinePayableAccount        Account?            @relation("PayrollFgtsFinePayableAccount", fields: [fgtsFinePayableAccountId], references: [id], onDelete: Restrict)
  taxBrackets                   PayrollTaxBracket[]

  @@map("payroll_settings")
}

// Faixa de tabela progressiva (INSS ou IRRF) no formato "alíquota efetiva
// menos parcela a deduzir": imposto_da_faixa = base*rate - deduction. Esse
// formato único serve tanto para IRRF (método oficial) quanto para INSS
// (progressivo desde a EC 103/2019) — ver PayrollCalculationService.
model PayrollTaxBracket {
  id                String         @id @default(uuid())
  organizationId    String         @map("organization_id")
  payrollSettingsId String         @map("payroll_settings_id")
  type              TaxBracketType
  minBase           Decimal        @map("min_base") @db.Decimal(18, 2)
  // null = sem teto (última faixa da tabela).
  maxBase           Decimal?       @map("max_base") @db.Decimal(18, 2)
  rate              Decimal        @db.Decimal(5, 4)
  deduction         Decimal        @db.Decimal(18, 2)

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  payrollSettings PayrollSettings @relation(fields: [payrollSettingsId], references: [id], onDelete: Cascade)

  @@index([organizationId, payrollSettingsId, type])
  @@map("payroll_tax_brackets")
}

model PayrollRun {
  id              String             @id @default(uuid())
  organizationId  String             @map("organization_id")
  runNumber       BigInt             @map("run_number")
  competenceYear  Int                @map("competence_year")
  competenceMonth Int                @map("competence_month")
  status          PayrollEventStatus @default(DRAFT)
  journalEntryId  String?            @map("journal_entry_id")
  createdBy       String             @map("created_by")
  createdAt       DateTime           @default(now()) @map("created_at")
  postedAt        DateTime?          @map("posted_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  journalEntry JournalEntry?    @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  lines        PayrollRunLine[]

  @@unique([organizationId, competenceYear, competenceMonth])
  @@unique([organizationId, runNumber])
  @@index([organizationId, status])
  @@map("payroll_runs")
}

model PayrollRunLine {
  id                       String  @id @default(uuid())
  organizationId           String  @map("organization_id")
  payrollRunId             String  @map("payroll_run_id")
  employeeId               String  @map("employee_id")
  baseSalary               Decimal @map("base_salary") @db.Decimal(18, 2)
  inssAmount               Decimal @map("inss_amount") @db.Decimal(18, 2)
  irrfAmount               Decimal @map("irrf_amount") @db.Decimal(18, 2)
  fgtsAmount               Decimal @map("fgts_amount") @db.Decimal(18, 2)
  employerInssAmount       Decimal @map("employer_inss_amount") @db.Decimal(18, 2)
  transportVoucherDiscount Decimal @default(0) @map("transport_voucher_discount") @db.Decimal(18, 2)
  mealVoucherBenefit       Decimal @default(0) @map("meal_voucher_benefit") @db.Decimal(18, 2)
  mealVoucherDiscount      Decimal @default(0) @map("meal_voucher_discount") @db.Decimal(18, 2)
  netPay                   Decimal @map("net_pay") @db.Decimal(18, 2)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  payrollRun   PayrollRun   @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([payrollRunId, employeeId])
  @@index([organizationId, payrollRunId])
  @@map("payroll_run_lines")
}

// Um evento por período aquisitivo gozado — não tenta reconciliar múltiplos
// períodos aquisitivos em aberto automaticamente (ver comentário de topo).
model Vacation {
  id                           String             @id @default(uuid())
  organizationId               String             @map("organization_id")
  employeeId                   String             @map("employee_id")
  acquisitionPeriodStart       DateTime           @map("acquisition_period_start") @db.Date
  acquisitionPeriodEnd         DateTime           @map("acquisition_period_end") @db.Date
  startDate                    DateTime           @map("start_date") @db.Date
  daysTaken                    Int                @map("days_taken")
  daysSold                     Int                @default(0) @map("days_sold")
  status                       PayrollEventStatus @default(DRAFT)
  vacationPay                  Decimal?           @map("vacation_pay") @db.Decimal(18, 2)
  constitutionalBonus          Decimal?           @map("constitutional_bonus") @db.Decimal(18, 2)
  sellBonus                    Decimal?           @map("sell_bonus") @db.Decimal(18, 2)
  sellBonusConstitutionalBonus Decimal?           @map("sell_bonus_constitutional_bonus") @db.Decimal(18, 2)
  inssAmount                   Decimal?           @map("inss_amount") @db.Decimal(18, 2)
  irrfAmount                   Decimal?           @map("irrf_amount") @db.Decimal(18, 2)
  fgtsAmount                   Decimal?           @map("fgts_amount") @db.Decimal(18, 2)
  employerInssAmount           Decimal?           @map("employer_inss_amount") @db.Decimal(18, 2)
  netPay                       Decimal?           @map("net_pay") @db.Decimal(18, 2)
  journalEntryId               String?            @map("journal_entry_id")
  createdBy                    String             @map("created_by")
  createdAt                    DateTime           @default(now()) @map("created_at")
  postedAt                     DateTime?          @map("posted_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)

  @@index([organizationId, employeeId])
  @@map("vacations")
}

model ThirteenthSalaryRun {
  id             String                      @id @default(uuid())
  organizationId String                      @map("organization_id")
  runNumber      BigInt                      @map("run_number")
  year           Int
  installment    ThirteenthSalaryInstallment
  status         PayrollEventStatus          @default(DRAFT)
  journalEntryId String?                     @map("journal_entry_id")
  createdBy      String                      @map("created_by")
  createdAt      DateTime                    @default(now()) @map("created_at")
  postedAt       DateTime?                   @map("posted_at")

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  journalEntry JournalEntry?             @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  lines        ThirteenthSalaryRunLine[]

  @@unique([organizationId, year, installment])
  @@unique([organizationId, runNumber])
  @@map("thirteenth_salary_runs")
}

model ThirteenthSalaryRunLine {
  id                        String  @id @default(uuid())
  organizationId            String  @map("organization_id")
  thirteenthSalaryRunId     String  @map("thirteenth_salary_run_id")
  employeeId                String  @map("employee_id")
  monthsWorked              Int     @map("months_worked")
  grossAmount               Decimal @map("gross_amount") @db.Decimal(18, 2)
  previousInstallmentAmount Decimal @default(0) @map("previous_installment_amount") @db.Decimal(18, 2)
  inssAmount                Decimal @default(0) @map("inss_amount") @db.Decimal(18, 2)
  irrfAmount                Decimal @default(0) @map("irrf_amount") @db.Decimal(18, 2)
  fgtsAmount                Decimal @default(0) @map("fgts_amount") @db.Decimal(18, 2)
  employerInssAmount        Decimal @default(0) @map("employer_inss_amount") @db.Decimal(18, 2)
  netPay                    Decimal @map("net_pay") @db.Decimal(18, 2)

  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  thirteenthSalaryRun ThirteenthSalaryRun @relation(fields: [thirteenthSalaryRunId], references: [id], onDelete: Cascade)
  employee            Employee            @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([thirteenthSalaryRunId, employeeId])
  @@map("thirteenth_salary_run_lines")
}

// Uma por funcionário (não pode ser desligado duas vezes) — verbas variam
// por `type` (ver PayrollCalculationService.calculateTermination).
model Termination {
  id                           String             @id @default(uuid())
  organizationId               String             @map("organization_id")
  employeeId                   String             @map("employee_id")
  terminationDate              DateTime           @map("termination_date") @db.Date
  type                         TerminationType
  status                       PayrollEventStatus @default(DRAFT)
  noticeDays                   Int?               @map("notice_days")
  balanceSalaryAmount          Decimal?           @map("balance_salary_amount") @db.Decimal(18, 2)
  noticeIndemnityAmount        Decimal?           @map("notice_indemnity_amount") @db.Decimal(18, 2)
  proportionalThirteenthAmount Decimal?           @map("proportional_thirteenth_amount") @db.Decimal(18, 2)
  vestedVacationAmount         Decimal?           @map("vested_vacation_amount") @db.Decimal(18, 2)
  proportionalVacationAmount   Decimal?           @map("proportional_vacation_amount") @db.Decimal(18, 2)
  vacationConstitutionalBonus  Decimal?           @map("vacation_constitutional_bonus") @db.Decimal(18, 2)
  fgtsFineAmount               Decimal?           @map("fgts_fine_amount") @db.Decimal(18, 2)
  inssAmount                   Decimal?           @map("inss_amount") @db.Decimal(18, 2)
  irrfAmount                   Decimal?           @map("irrf_amount") @db.Decimal(18, 2)
  netPay                       Decimal?           @map("net_pay") @db.Decimal(18, 2)
  journalEntryId               String?            @map("journal_entry_id")
  createdBy                    String             @map("created_by")
  createdAt                    DateTime           @default(now()) @map("created_at")
  postedAt                     DateTime?          @map("posted_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)

  @@unique([employeeId])
  @@index([organizationId, employeeId])
  @@map("terminations")
}

// ============================================================================
// Fiscal — apuração automática de tributos (Simples Nacional / Lucro
// Presumido / Lucro Real) e emissão de documentos (NF-e/NFS-e)
// ============================================================================
// Simplificações assumidas (ver ApuracaoTributariaService para o detalhe):
// RBT12 é digitado/atualizado manualmente pelo contador, não reconstruído
// automaticamente do histórico de vendas; ICMS não tem granularidade por
// NCM/produto nem substituição tributária/redução de base, só uma alíquota
// interna configurável por UF (a alíquota interestadual usa a matriz fixa
// da Resolução do Senado 22/89, que não muda, embutida no código); PIS/COFINS
// usam uma alíquota agregada configurável por regime (cumulativo/não-cumulativo),
// sem apurar créditos de insumos; ISS usa uma única alíquota por organização,
// sem tabela por município/serviço. Tabelas do Simples Nacional vêm com
// valores de referência (Anexo III, o mais comum para serviços) — o mesmo
// "confira antes de usar" das tabelas de INSS/IRRF do Departamento Pessoal.

model FiscalTaxSettings {
  id                      String                @id @default(uuid())
  organizationId          String                @unique @map("organization_id")
  regimeTributario        RegimeTributario      @map("regime_tributario")
  anexoSimplesNacional    AnexoSimplesNacional? @map("anexo_simples_nacional")
  // Receita bruta acumulada nos últimos 12 meses — usada para achar a faixa
  // do Simples Nacional. Atualizada manualmente pelo contador todo mês.
  receitaBruta12Meses     Decimal               @default(0) @map("receita_bruta_12_meses") @db.Decimal(18, 2)
  pisCofinsRegime         PisCofinsRegime?      @map("pis_cofins_regime")
  pisRate                 Decimal               @default(0) @map("pis_rate") @db.Decimal(5, 4)
  cofinsRate              Decimal               @default(0) @map("cofins_rate") @db.Decimal(5, 4)
  issRate                 Decimal               @default(0) @map("iss_rate") @db.Decimal(5, 4)
  icmsDefaultInternalRate Decimal               @default(0) @map("icms_default_internal_rate") @db.Decimal(5, 4)

  receitaVendasAccountId               String? @map("receita_vendas_account_id")
  receitaServicosAccountId             String? @map("receita_servicos_account_id")
  deducoesTributariasVendasAccountId   String? @map("deducoes_tributarias_vendas_account_id")
  deducoesTributariasServicosAccountId String? @map("deducoes_tributarias_servicos_account_id")
  clientesAReceberAccountId            String? @map("clientes_a_receber_account_id")
  icmsPayableAccountId                 String? @map("icms_payable_account_id")
  pisPayableAccountId                  String? @map("pis_payable_account_id")
  cofinsPayableAccountId               String? @map("cofins_payable_account_id")
  issPayableAccountId                  String? @map("iss_payable_account_id")
  simplesNacionalPayableAccountId      String? @map("simples_nacional_payable_account_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization                       Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  receitaVendasAccount               Account?                 @relation("FiscalReceitaVendasAccount", fields: [receitaVendasAccountId], references: [id], onDelete: Restrict)
  receitaServicosAccount             Account?                 @relation("FiscalReceitaServicosAccount", fields: [receitaServicosAccountId], references: [id], onDelete: Restrict)
  deducoesTributariasVendasAccount   Account?                 @relation("FiscalDeducoesVendasAccount", fields: [deducoesTributariasVendasAccountId], references: [id], onDelete: Restrict)
  deducoesTributariasServicosAccount Account?                 @relation("FiscalDeducoesServicosAccount", fields: [deducoesTributariasServicosAccountId], references: [id], onDelete: Restrict)
  clientesAReceberAccount            Account?                 @relation("FiscalClientesReceberAccount", fields: [clientesAReceberAccountId], references: [id], onDelete: Restrict)
  icmsPayableAccount                 Account?                 @relation("FiscalIcmsPayableAccount", fields: [icmsPayableAccountId], references: [id], onDelete: Restrict)
  pisPayableAccount                  Account?                 @relation("FiscalPisPayableAccount", fields: [pisPayableAccountId], references: [id], onDelete: Restrict)
  cofinsPayableAccount               Account?                 @relation("FiscalCofinsPayableAccount", fields: [cofinsPayableAccountId], references: [id], onDelete: Restrict)
  issPayableAccount                  Account?                 @relation("FiscalIssPayableAccount", fields: [issPayableAccountId], references: [id], onDelete: Restrict)
  simplesNacionalPayableAccount      Account?                 @relation("FiscalSimplesPayableAccount", fields: [simplesNacionalPayableAccountId], references: [id], onDelete: Restrict)
  simplesBrackets                    SimplesNacionalBracket[]
  icmsUfRates                        IcmsUfRate[]

  @@map("fiscal_tax_settings")
}

// Mesmo formato "alíquota efetiva menos parcela a deduzir" das faixas de
// INSS/IRRF do Departamento Pessoal — aqui aplicado à alíquota efetiva do
// DAS do Simples Nacional, mais a quebra percentual entre os tributos que o
// DAS engloba (IRPJ/CSLL/COFINS/PIS/CPP + ICMS-ou-ISS conforme o anexo).
model SimplesNacionalBracket {
  id                  String               @id @default(uuid())
  organizationId      String               @map("organization_id")
  fiscalTaxSettingsId String               @map("fiscal_tax_settings_id")
  anexo               AnexoSimplesNacional
  rbt12Min            Decimal              @map("rbt12_min") @db.Decimal(18, 2)
  rbt12Max            Decimal?             @map("rbt12_max") @db.Decimal(18, 2)
  aliquotaNominal     Decimal              @map("aliquota_nominal") @db.Decimal(5, 4)
  parcelaDeduzir      Decimal              @map("parcela_deduzir") @db.Decimal(18, 2)
  percentualIrpj      Decimal              @map("percentual_irpj") @db.Decimal(5, 4)
  percentualCsll      Decimal              @map("percentual_csll") @db.Decimal(5, 4)
  percentualCofins    Decimal              @map("percentual_cofins") @db.Decimal(5, 4)
  percentualPis       Decimal              @map("percentual_pis") @db.Decimal(5, 4)
  percentualCpp       Decimal              @map("percentual_cpp") @db.Decimal(5, 4)
  percentualIcmsOuIss Decimal              @map("percentual_icms_ou_iss") @db.Decimal(5, 4)

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  fiscalTaxSettings FiscalTaxSettings @relation(fields: [fiscalTaxSettingsId], references: [id], onDelete: Cascade)

  @@index([organizationId, fiscalTaxSettingsId, anexo])
  @@map("simples_nacional_brackets")
}

// Alíquota interna de ICMS por UF (varia por estado, muda de tempos em
// tempos) — a interestadual usa a matriz fixa da Resolução 22/89, embutida
// no código, já que não muda desde então.
model IcmsUfRate {
  id                  String  @id @default(uuid())
  organizationId      String  @map("organization_id")
  fiscalTaxSettingsId String  @map("fiscal_tax_settings_id")
  uf                  String  @db.Char(2)
  internalRate        Decimal @map("internal_rate") @db.Decimal(5, 4)

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  fiscalTaxSettings FiscalTaxSettings @relation(fields: [fiscalTaxSettingsId], references: [id], onDelete: Cascade)

  @@unique([fiscalTaxSettingsId, uf])
  @@map("icms_uf_rates")
}

// Snapshot do documento fiscal emitido — o restante do módulo Fiscal
// (ContextoContabilFiscal/estratégias) é propositalmente stateless (só gera
// o lançamento contábil), mas para listar documentos emitidos e regerar o
// XML depois é preciso guardar o documento em algum lugar. `documentoJson`
// é a única coluna JSON deste schema de propósito: os itens são uma lista
// aninhada de tamanho variável que nunca precisa ser filtrada via SQL, só
// reidratada para reexibição/regeração de XML — as colunas ao lado existem
// para as consultas/índices que a listagem realmente usa.
model FiscalDocumentoEmitido {
  id               String   @id @default(uuid())
  organizationId   String   @map("organization_id")
  tipo             String
  naturezaOperacao String   @map("natureza_operacao")
  numeroDocumento  String   @map("numero_documento")
  dataEmissao      DateTime @map("data_emissao") @db.Date
  dataCompetencia  DateTime @map("data_competencia") @db.Date
  contraparteId    String   @map("contraparte_id")
  valorTotal       Decimal  @map("valor_total") @db.Decimal(18, 2)
  documentoJson    Json     @map("documento_json")
  journalEntryId   String   @map("journal_entry_id")
  createdBy        String   @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)

  @@unique([organizationId, numeroDocumento])
  @@index([organizationId, dataEmissao])
  @@map("fiscal_documentos_emitidos")
}
