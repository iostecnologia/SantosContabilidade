# Conexão de runtime da API — usa o papel restrito por RLS.
DATABASE_URL="postgresql://app_user:app_user_dev_password@localhost:5432/santos_saf?schema=public"

# Conexão usada apenas por `prisma migrate` — dono das tabelas, ignora RLS.
MIGRATE_DATABASE_URL="postgresql://app_migrator:app_migrator_dev_password@localhost:5432/santos_saf?schema=public"

PORT=3000

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_TTL_DAYS=7
