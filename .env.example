# Usado pelo docker-compose (raiz do projeto) para os serviços `postgres` e `api`.
# Copie para `.env` e gere valores aleatórios fortes antes de subir em produção:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=troque-por-um-segredo-aleatorio-forte
JWT_REFRESH_SECRET=troque-por-outro-segredo-aleatorio-forte

# Senhas do Postgres — nunca hardcode estas no docker-compose.yml ou nos
# scripts de init (docker/postgres-init/), mesmo sendo "só dev": este
# repositório é público.
POSTGRES_SUPERUSER_PASSWORD=troque-por-uma-senha-forte
APP_MIGRATOR_PASSWORD=troque-por-outra-senha-forte
APP_USER_PASSWORD=troque-por-outra-senha-forte-ainda
